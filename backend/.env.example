# Copy to .env and fill in. Never commit .env — it is gitignored.

# PostgreSQL connection string (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://dnd_user:changeme@localhost:5432/dnd_manager

# Used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-a-random-string

# Optional. How long an access token stays valid. Defaults to 30.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional. Comma-separated browser origins allowed to call the API.
# Defaults to the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Only read by the test suite (see tests/conftest.py). Must be a SEPARATE
# database — the fixtures truncate every table between tests.
TEST_DATABASE_URL=postgresql+psycopg://dnd_user:changeme@localhost:5432/dnd_manager_test
